<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_panel"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HU Bot v2"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOverlayClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="X"
            android:textColor="#EF9A9A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOverlayStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="230dp"
        android:text="Ready • 3 Art (30)"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#2E7D32"
            android:minWidth="70dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="PLAY"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStopRun"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#C62828"
            android:minWidth="52dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="STOP"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSyncOverlay"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#00838F"
            android:minWidth="52dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="SYNC"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnQuickEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#1565C0"
            android:minWidth="46dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="QTY"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnToggleTargets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="Hide Targets"
            android:textColor="#90CAF9"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvDelayQuick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:padding="4dp"
            android:text="Delay: 2.5s"
            android:textColor="#B0BEC5"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
